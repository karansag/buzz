#!/usr/bin/env python3
"""Install (or with --remove, uninstall) the agent-swarm startup hooks.

  Claude Code  SessionStart hook in ~/.claude/settings.json
               PreModelSwitch hook there too, so a model switch never asks
  Codex        SessionStart hook in ~/.codex/hooks.json (trust it once via /hooks)
  Pi           extension linked at ~/.pi/agent/extensions/agent-swarm
  Antigravity  SessionStart hook in ~/.gemini/config/hooks.json

The startup hooks run `buzz autoregister`, which registers the session only
when its harness runs straight in its own tmux pane. Claude Code's
PreModelSwitch hook runs `buzz allow-model-switch`: a long conversation makes
Claude Code ask before switching models ("the full history gets re-read"),
and a switch made from Buzz is always intentional. JSON files are backed up
to <file>.bak-<time> before they change.
"""

import json
import os
import shlex
import shutil
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
HOME = Path.home()
STAMP = time.strftime("%Y%m%d-%H%M%S") + f"-{time.time_ns()}"
NAME = "agent-swarm"


def back_up(path: Path) -> None:
    """Keep the file as it was before this run, once, even if it changes twice."""
    backup = path.with_name(f"{path.name}.bak-{STAMP}")
    if path.exists() and not backup.exists():
        shutil.copy2(path, backup)


def is_our_hook(command: str) -> bool:
    if not isinstance(command, str):
        return False
    try:
        words = shlex.split(command)
    except ValueError:
        return False
    ours = (["autoregister", "--hook"], ["allow-model-switch"])
    return bool(words) and Path(words[0]).name in ("buzz", "agent-swarm") and words[1:] in ours


def edit_hooks(path: Path, event: str, remove: bool, command: str | None) -> None:
    config = json.loads(path.read_text()) if path.exists() else {}
    groups = config.setdefault("hooks", {}).setdefault(event, [])
    kept = []
    for group in groups:
        handlers = group.get("hooks", [])
        remaining = [h for h in handlers if not is_our_hook(h.get("command", ""))]
        if remaining == handlers:
            kept.append(group)
        elif remaining:
            # Only remove our handler, preserving other handlers and matcher
            # metadata even if a user put them in the same group.
            kept.append({**group, "hooks": remaining})
    if not remove:
        kept.append({"hooks": [{"type": "command", "command": command, "timeout": 15}]})
    if kept == groups:
        print(f"{path}: unchanged")
        return
    config["hooks"][event] = kept
    if not kept:
        del config["hooks"][event]
    if not config["hooks"]:
        del config["hooks"]
    back_up(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2) + "\n")
    print(f"{path}: {'removed' if remove else 'added'} {event} hook")


def is_our_agent_hook(handler: object) -> bool:
    return isinstance(handler, dict) and is_our_hook(handler.get("command", ""))


def edit_agy_hooks(path: Path, remove: bool, command: str | None) -> None:
    """Antigravity CLI keeps each hook's handlers beside a name in its own file.

    `SessionStart` handlers sit in a flat list (matchers are for tool events
    only), and a handler's timeout is in seconds.
    """
    original = json.loads(path.read_text()) if path.exists() else {}
    if not isinstance(original, dict):
        sys.exit(f"{path} must contain a JSON object")
    config = dict(original)
    before = original.get(NAME)
    ours = dict(before) if isinstance(before, dict) else {}
    handlers = ours.get("SessionStart")
    handlers = handlers if isinstance(handlers, list) else []
    kept = [h for h in handlers if not is_our_agent_hook(h)]
    if remove:
        ours = {**ours, "SessionStart": kept}
    else:
        ours = {**ours, "SessionStart": [*kept, {"type": "command", "command": command, "timeout": 15}]}
    if not ours["SessionStart"]:
        del ours["SessionStart"]
    if ours:
        config[NAME] = ours
    else:
        config.pop(NAME, None)
    if config == original:
        print(f"{path}: unchanged")
        return
    back_up(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(config, indent=2) + "\n")
    print(f"{path}: {'removed' if remove else 'added'} SessionStart hook")


def link_pi(remove: bool) -> None:
    agent_dir = Path(os.environ.get("PI_CODING_AGENT_DIR") or HOME / ".pi/agent")
    dest = agent_dir / "extensions/agent-swarm"
    if dest.is_symlink():
        dest.unlink()
    elif dest.exists():
        sys.exit(f"{dest} exists and is not a link; move it away first")
    if remove:
        print(f"{dest}: removed")
        return
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.symlink_to(HERE / "pi/agent-swarm")
    print(f"{dest} -> {HERE / 'pi/agent-swarm'}")


def main() -> None:
    remove = "--remove" in sys.argv[1:]
    command = switch_command = None
    if not remove:
        executable = shutil.which("buzz")
        if not executable:
            sys.exit("buzz is not on PATH; install its CLI before installing startup hooks")
        # Keep the stable launcher path (e.g. ~/.local/bin/buzz), not
        # its realpath into a uv environment that can change on reinstall.
        command = f"{shlex.quote(os.path.abspath(executable))} autoregister --hook"
        switch_command = f"{shlex.quote(os.path.abspath(executable))} allow-model-switch"
    edit_hooks(HOME / ".claude/settings.json", "SessionStart", remove, command)
    # Claude Code asks before switching models once a conversation has
    # content. Buzz switches are deliberate, so answer that hook with allow.
    edit_hooks(HOME / ".claude/settings.json", "PreModelSwitch", remove, switch_command)
    edit_hooks(Path(os.environ.get("CODEX_HOME") or HOME / ".codex") / "hooks.json", "SessionStart", remove, command)
    # Antigravity CLI reads its own hooks.json, with SessionStart handlers
    # flat (no matcher group) and a timeout in seconds.
    edit_agy_hooks(HOME / ".gemini" / "config" / "hooks.json", remove, command)
    link_pi(remove)
    if not remove:
        print("Codex skips new hooks until trusted: run /hooks in Codex once and trust it.")


if __name__ == "__main__":
    main()
