{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Buzz",
  "version": "0.1.0",
  "identifier": "com.karansag.agent-swarm",
  "build": { "frontendDist": "../setup" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": ["setup"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "10.15", "signingIdentity": "-" }
  }
}
